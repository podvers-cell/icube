# ===========================================
# ICUBE Media Studio – Environment variables
# Copy to .env or .env.local and fill with your values.
# Never commit .env or .env.local (they are in .gitignore).
# ===========================================

# ---- Server-only (do NOT expose in client) ----
# GEMINI_API_KEY: Used by optional server features (e.g. AI). Not needed for Firebase-only setup.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: Base URL of the deployed app (e.g. https://your-domain.vercel.app)
APP_URL="https://your-domain.com"

# ---- Firebase (client; Next.js) ----
# Required for the app. Get these from Firebase Console → Project settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ---- Cloudinary (dashboard uploads: images & videos to website) ----
# From Cloudinary Console → Product Environment Credentials
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Optional: use CLOUDINARY_URL instead: cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ---- Dashboard uploads ----
# Uploads use the signed-in Firebase administrator's ID token.
# Do not add a public upload API key.

# ---- Firebase Admin (server-only; required for booking/payment API routes) ----
# Same Firebase project as NEXT_PUBLIC_FIREBASE_PROJECT_ID (currently used client-side).
# Create in: Firebase Console → Project settings → Service accounts → Generate new private key
#
# Option A (recommended on Vercel): paste the entire JSON file as one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"icube-817ab","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@icube-817ab.iam.gserviceaccount.com",...}
#
# Option B: split fields (private key must keep \n for newlines)
# FIREBASE_PROJECT_ID="icube-817ab"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@icube-817ab.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Option C (local dev only): save the downloaded JSON in the project root (gitignored).
# Works with Firebase default name, e.g. icube-817ab-firebase-adminsdk-xxxxx.json,
# or rename to firebase-service-account.json, or set FIREBASE_SERVICE_ACCOUNT_PATH.

# ---- Ziina payments ----
# ZIINA_API_KEY="your-ziina-api-key"
# ZIINA_WEBHOOK_SECRET="your-webhook-hmac-secret"
# ZIINA_TEST_MODE="true"

# ---- Contact form & booking emails (Resend) ----
# Get API key at https://resend.com.
RESEND_API_KEY="re_xxxxxxxxxxxx"
# For inbox delivery (not spam): verify your domain at https://resend.com/domains, then set:
# CONTACT_FROM_EMAIL="ICUBE Media Studio <noreply@icubeproduction.com>"
# Optional: override recipient for contact form (default: info@icubeproduction.com)
# CONTACT_TO_EMAIL="info@icubeproduction.com"

# ---- Contact form abuse protection (Cloudflare Turnstile) ----
# The contact form sends a confirmation to whatever address is submitted, so without a challenge
# it can be used to mail a victim on your Resend account and sending domain.
#
# Verification is skipped entirely while TURNSTILE_SECRET_KEY is unset — setting it is what turns
# enforcement on, so deploy the key and the front-end widget together.
# Keys: https://dash.cloudflare.com → Turnstile.
# TURNSTILE_SECRET_KEY="0x4AAA..."
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAA..."   # site key is public by design
